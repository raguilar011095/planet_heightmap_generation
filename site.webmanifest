        },
        {
            "src": "assets/brand/icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "assets/brand/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "assets/brand/favicon.svg",
            "sizes": "any",
            "type": "image/svg+xml"
        }
    ]
}
