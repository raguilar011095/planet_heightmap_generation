{
    "name": "World Orogen",
    "short_name": "Orogen",
    "description": "Believable worlds from the ground up: free planet tools in your browser, from tectonic history to climate, rocks and food",
    "start_url": "/",
    "display": "browser",
    "background_color": "#FBFAF6",
    "theme_color": "#FBFAF6",
